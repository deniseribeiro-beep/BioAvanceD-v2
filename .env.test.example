NODE_ENV=test
TEST_ENVIRONMENT=true
MONGO_URI=mongodb://mongodb-test:27017/bioavanced_test?replicaSet=rs0
MONGO_DB=bioavanced_test
MONGO_DB_NOVO=bioavanced_test
NEO4J_URI=bolt://neo4j-test:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=testpassword
# neo4j:5-community only supports the default `neo4j` database — named
# databases are an Enterprise-only feature (#292).
NEO4J_DATABASE=neo4j
REDIS_URL=redis://redis-test:6379
INFLUXDB_URL=http://influxdb-test:8086
INFLUXDB_TOKEN=bioavanced-test-token
INFLUXDB_ORG=bioavanced-test
INFLUXDB_BUCKET=bioavanced-test
JWT_SECRET=vitest-secret-key
JWT_REFRESH_SECRET=vitest-refresh-secret-key
ENCRYPTION_KEY=vitest-encryption-key-for-lab-validation-32b
ENCRYPTION_KEY_ID=vitest-key-001
RESEND_API_KEY=vitest-resend-api-key
EMAIL_FROM=onboarding@resend.dev
USER_ANON_SALT=vitest-user-anon-salt
CONSENT_SECRET=vitest-consent-secret-key
TEST_SUPPORT_SECRET=e2e-test-support-secret
# #675: explicit opt-in required for test-support routes to be registered
# at all, on top of TEST_SUPPORT_SECRET above -- see utils/testSupportGate.js.
ENABLE_TEST_SUPPORT_ROUTES=true
ALLOW_CLOUD_INTEGRATIONS=false
ALLOW_EXTERNAL_TERMINOLOGY_SYNC=false
ALLOW_EXTERNAL_HPO_LOOKUP=false
ALLOW_EXTERNAL_DRUG_LOOKUP=false

