NODE_ENV=test
MONGO_URI=mongodb://mongodb-test:27017/bioavanced_test?replicaSet=rs0
MONGO_DB=bioavanced_test
MONGO_DB_NOVO=bioavanced_test
NEO4J_URI=bolt://neo4j-test:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=testpassword
# neo4j:5-community only supports the default `neo4j` database — named
# databases are an Enterprise-only feature (#292).
NEO4J_DATABASE=neo4j
REDIS_URL=redis://redis-test:6379
INFLUXDB_URL=http://influxdb-test:8086
INFLUXDB_TOKEN=bioavanced-test-token
INFLUXDB_ORG=bioavanced-test
INFLUXDB_BUCKET=bioavanced-test
JWT_SECRET=vitest-secret-key
JWT_REFRESH_SECRET=vitest-refresh-secret-key
ENCRYPTION_KEY=vitest-encryption-key-for-lab-validation-32b
ENCRYPTION_KEY_ID=vitest-key-001
RESEND_API_KEY=vitest-resend-api-key
EMAIL_FROM=onboarding@resend.dev
USER_ANON_SALT=vitest-user-anon-salt
CONSENT_SECRET=vitest-consent-secret-key
# #829: NotificationService.getFrontendUrl() throws when this is empty, and
# POST /e-consent/generate-link turned that throw into a process exit. Must be
# HTTPS and non-loopback -- sendConsentEmail calls validateFrontendUrl({
# remote: true }), which refuses to email a plaintext or loopback link. Kept in
# step with compose.test.yml's x-test-env block.
FRONTEND_URL=https://e2e.bioavanced.test
# Access proxy (:8080) and public HTTPS — browser Origin must be allowlisted
# or POST /auth/password-reset/request returns HTTP 500 from cors().
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://bioadvanced.dev,https://www.bioadvanced.dev,http://localhost:5173,http://127.0.0.1:5173
TEST_SUPPORT_SECRET=e2e-test-support-secret

# #1054: credential for machine/IoT telemetry ingest -- covers both
# POST /api/temperature/system/reading and POST /api/iot/telemetry (the
# route the e2e suite actually exercises), which were previously mounted
# with no middleware at all. FAILS CLOSED: leaving this unset does not make
# the route anonymous, it makes the route unavailable (utils/
# machineIngestGate.js, same rule #675 established for TEST_SUPPORT_SECRET).
# Set it only on a stack that actually has a sensor or gateway posting
# readings, and give the device the same value in an
# x-telemetry-ingest-secret header.
TELEMETRY_INGEST_SECRET=e2e-telemetry-ingest-secret
# #675: explicit opt-in required for test-support routes to be registered
# at all, on top of TEST_SUPPORT_SECRET above -- see utils/testSupportGate.js.
ENABLE_TEST_SUPPORT_ROUTES=true
ALLOW_CLOUD_INTEGRATIONS=false
ALLOW_EXTERNAL_TERMINOLOGY_SYNC=false
ALLOW_EXTERNAL_HPO_LOOKUP=false
ALLOW_EXTERNAL_DRUG_LOOKUP=false


# Scheduled jobs (#754)
# The scheduler is NOT disabled on the test stack -- server.js#startServer
# calls initScheduler() unconditionally, with no NODE_ENV gate -- so the
# nightly backup, the retention sweep and the weekly restore test all run
# here too. The restore test is the one to know about: it creates scratch
# `*_restoretest_*` databases (see #753 for orphans left by earlier runs).
#
# The knobs and their defaults are documented in .env.docker.example; set
# them here as well if a test stack is long-lived enough for the schedules
# to matter.
