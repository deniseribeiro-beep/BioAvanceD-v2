# ==========================
# Docker Compose ports
# ==========================
FRONTEND_PORT=8080
BACKEND_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
INFLUXDB_PORT=8086

# ==========================
# MongoDB local (container)
# ==========================
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=ChangeMeMongo!
MONGO_DB=bioavanced
MONGO_DB_NOVO=bioavanced_new

# ==========================
# Redis local (container)
# ==========================
REDIS_PASSWORD=ChangeMeRedis!

# ==========================
# Neo4j local (container)
# ==========================
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ChangeMeNeo4j!
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false

# ==========================
# InfluxDB local (container)
# ==========================
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=ChangeMeInflux!
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=ChangeMeInfluxToken123456789

# ==========================
# Backend secrets (required)
# ==========================
JWT_SECRET=ChangeMeJwtSecret
JWT_REFRESH_SECRET=ChangeMeJwtRefreshSecret
ENCRYPTION_KEY=12345678901234567890123456789012
USER_ANON_SALT=ChangeMeAnonSalt

# ==========================
# Runtime behavior
# ==========================
LINEAGE_MODE=fail-open
FHIR_READ_MODE=fhir-first
TRUST_PROXY=1
BACKUP_DIR=/app/backups

# ==========================
# Initial admin bootstrap (first run only)
# ==========================
INITIAL_ADMIN_EMAIL=admin@bioavanced.com.br
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME=Administrador

# ==========================
# Neo4j Quarantine (Self-Healing)
# ==========================
NEO4J_RETRY_QUEUE_KEY=neo4j_retry_queue
NEO4J_RETRY_INTERVAL_MS=30000
NEO4J_RETRY_BATCH_SIZE=20
NEO4J_RETRY_MAX_ATTEMPTS=50

# ==========================
# Dynamic Telemetry Monitor (Influx -> Neo4j)
# ==========================
TELEMETRY_MONITOR_CRON=*/5 * * * *
TELEMETRY_CRITICAL_TEMP=-80
TELEMETRY_CRITICAL_DURATION_HOURS=2
TELEMETRY_LOOKBACK_HOURS=4
TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30

# ==========================
# Mongo migration script env
# ==========================
MONGO_SOURCE_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_SOURCE_DB=bioavanced_prod
MONGO_TARGET_URI=mongodb://root:ChangeMeMongo!@localhost:27017/?authSource=admin
MONGO_TARGET_DB=bioavanced
MONGO_MIGRATE_BATCH_SIZE=1000

# ==========================
# Unified Notifications (Resend)
# ==========================
RESEND_API_KEY=re_KjcxzczE_9eqmcXo2HkAdZfSPU5okGRMT
EMAIL_FROM=onboarding@resend.dev
ALERT_EMAIL_TO=admin@bioavanced.com.br
ADMIN_EMAIL=admin@bioavanced.com.br
