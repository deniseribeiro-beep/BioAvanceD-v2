{
  "name": "bioavanced-backend",
  "version": "1.0.0",
  "description": "Backend API para sistema de gerenciamento de amostras biológicas - BioAvanceD",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node ./src/workers/worker.js",
    "worker:dev": "nodemon ./src/workers/worker.js",
    "create-db": "node scripts/create-db.js",
    "sync-collections": "node scripts/sync-collections.js",
    "sync:consent:neo4j": "node scripts/sync-consent-neo4j.js",
    "migrate:mongo:online-local": "node scripts/migrate-mongo-online-to-local.js",
    "migrate:rcs": "node src/scripts/migrate-rcs-governance-indexes.js",
    "remediate:fhir:barcode": "node scripts/remediate-fhir-missing-barcodes.js",
    "validate:fhir:barcode": "node scripts/check-fhir-barcode-coverage.js",
    "audit": "node scripts/audit-database.js",
    "audit:verify": "node scripts/audit-verify.js",
    "audit:verify-chain": "node scripts/audit-verify-chain.js",
    "audit:verify-witnesses": "node scripts/audit-verify-witnesses.js",
    "audit:migrate": "node scripts/audit-migrate-v2.js",
    "audit:e2e-real": "node scripts/audit-e2e-real.js",
    "neo4j:canonical:rebuild": "node scripts/neo4j-canonical-rebuild.js",
    "neo4j:canonical:worker": "node src/workers/neo4jProjection.worker.js",
    "audit:frontend": "node scripts/audit-frontend-backend.js",
    "test:mongo": "node scripts/test-connection-mongo.js",
    "test:connections": "node scripts/test-connections.js",
    "setup": "node setup-env.js",
    "find-port": "node scripts/find-port.js",
    "kill-port": "node scripts/kill-port.js",
    "check-ports": "node scripts/check-ports.js",
    "admin:create-first": "node src/scripts/createFirstAdmin.js",
    "user:create-admin": "npm run admin:create-first",
    "lab:test": "node scripts/lab-test-notifications.js",
    "iot:simulate": "node scripts/iot-simulator.js",
    "cleanup": "node ../scripts/cleanup-complete.js",
    "clean": "node ../scripts/cleanup-complete.js",
    "test:redis": "node scripts/test-redis-connection.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run && node tests/compliance/generate-compliance-evidence.js",
    "lint": "node scripts/lint.js",
    "typecheck": "node scripts/lint.js"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "1.35.0",
    "ajv": "8.18.0",
    "ajv-formats": "2.1.1",
    "argon2": "0.31.2",
    "bcryptjs": "2.4.3",
    "bullmq": "^5.79.2",
    "bwip-js": "4.8.0",
    "cors": "2.8.5",
    "crypto-js": "4.2.0",
    "csv-parser": "3.2.0",
    "csv-stringify": "6.6.0",
    "dotenv": "16.6.1",
    "exceljs": "^3.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.3.1",
    "fast-xml-parser": "^5.9.3",
    "helmet": "7.2.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.21.0",
    "mongoose": "9.2.1",
    "mqtt": "5.15.0",
    "multer": "^2.2.0",
    "neo4j-driver": "6.0.1",
    "node-cron": "^4.5.0",
    "qrcode": "1.5.4",
    "redis": "^5.0.0",
    "resend": "^6.17.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "4.8.1",
    "speakeasy": "2.0.0",
    "uuid": "^14.0.1",
    "yauzl": "3.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.0",
    "vitest": "^4.0.7"
  },
  "overrides": {
    "minimatch@<3.1.4": "3.1.4",
    "minimatch@>=5.0.0 <5.1.8": "5.1.8",
    "tar": "^7.5.9"
  }
}
