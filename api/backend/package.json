{
  "name": "bioavanced-backend",
  "version": "1.0.0",
  "description": "Backend API para sistema de gerenciamento de amostras biológicas - BioAvanceD",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node ./src/workers/worker.js",
    "worker:dev": "nodemon ./src/workers/worker.js",
    "create-db": "node scripts/create-db.js",
    "sync-collections": "node scripts/sync-collections.js",
    "sync:consent:neo4j": "node scripts/sync-consent-neo4j.js",
    "seed": "npm run seed:essential",
    "seed:essential": "node src/scripts/seedEssential.js",
    "seed:cid": "node src/scripts/seedOrphanetCid.js",
    "seed:disease-rules": "node src/scripts/seedDiseaseValidationRules.js",
    "seed:atc-bootstrap": "node src/scripts/seeder.js",
    "migrate:mongo:online-local": "node scripts/migrate-mongo-online-to-local.js",
    "migrate:rcs": "node src/scripts/migrate-rcs-governance-indexes.js",
    "remediate:fhir:barcode": "node scripts/remediate-fhir-missing-barcodes.js",
    "validate:fhir:barcode": "node scripts/check-fhir-barcode-coverage.js",
    "audit": "node scripts/audit-database.js",
    "orphanet:fetch": "node scripts/orphanet-fetch-api-once.js",
    "orphanet:build": "node scripts/orphanet-build-artifact.js",
    "orphanet:build-from-pack": "node scripts/orphanet-build-artifact-from-pack.js",
    "orphanet:validate-artifact": "node scripts/orphanet-validate-artifact.js",
    "orphanet:import": "node scripts/orphanet-import-artifact.js",
    "orphanet:validate-contract": "node scripts/orphanet-validate-contract.js",
    "orphanet:build-initial-seed": "node scripts/orphanet-build-initial-seed-from-raw.js",
    "orphanet:validate-initial-seed": "node scripts/orphanet-validate-initial-seed.js",
    "orphanet:enrich-omim": "node scripts/orphanet-enrich-initial-seed-omim.js",
    "orphanet:import-initial-seed": "node scripts/orphanet-import-initial-seed.js",
    "orphanet:validate-imported-seed": "node scripts/orphanet-validate-imported-seed.js",
    "audit:frontend": "node scripts/audit-frontend-backend.js",
    "test:mongo": "node scripts/test-connection-mongo.js",
    "test:connections": "node scripts/test-connections.js",
    "setup": "node setup-env.js",
    "find-port": "node scripts/find-port.js",
    "kill-port": "node scripts/kill-port.js",
    "check-ports": "node scripts/check-ports.js",
    "admin:create-first": "node src/scripts/createFirstAdmin.js",
    "user:create-admin": "npm run admin:create-first",
    "lab:test": "node scripts/lab-test-notifications.js",
    "iot:simulate": "node scripts/iot-simulator.js",
    "cleanup": "node ../scripts/cleanup-complete.js",
    "clean": "node ../scripts/cleanup-complete.js",
    "test:redis": "node scripts/test-redis-connection.js",
    "test": "vitest run",
    "test:security": "node tests/unit/security.test.js",
    "test:consent": "node tests/unit/authConsent.test.js",
    "test:unit": "node tests/unit/run-tests.js && node tests/unit/authConsent.test.js",
    "test:ci": "vitest run && node tests/unit/security.test.js && node tests/unit/authConsent.test.js && node tests/compliance/generate-compliance-evidence.js"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "latest",
    "@vitest/browser": "^4.0.7",
    "ajv": "latest",
    "ajv-formats": "latest",
    "argon2": "latest",
    "bcryptjs": "latest",
    "bullmq": "latest",
    "bwip-js": "latest",
    "cors": "latest",
    "crypto-js": "latest",
    "csv-parser": "latest",
    "csv-stringify": "latest",
    "dotenv": "latest",
    "exceljs": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "express-validator": "latest",
    "fast-xml-parser": "latest",
    "helmet": "latest",
    "ioredis": "latest",
    "jsonwebtoken": "latest",
    "mongodb": "latest",
    "mongoose": "latest",
    "mqtt": "latest",
    "multer": "latest",
    "neo4j-driver": "latest",
    "node-cron": "latest",
    "qrcode": "latest",
    "redis": "latest",
    "resend": "latest",
    "socket.io": "^4.8.3",
    "socket.io-client": "latest",
    "speakeasy": "latest",
    "uuid": "latest",
    "yauzl": "latest"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.2.0",
    "vitest": "^4.0.7"
  },
  "overrides": {
    "minimatch@<3.1.4": "3.1.4",
    "minimatch@>=5.0.0 <5.1.8": "5.1.8",
    "tar": "^7.5.9"
  }
}
