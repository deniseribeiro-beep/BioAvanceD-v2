{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/full-suite-guard.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/branch-guard.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/push-wrapup-checkpoint.cjs"
          }
        ]
      }
    ]
  }
}
