{
  "scripts": {
    "compose:config": "docker compose --env-file .env.docker.example -f compose.yml -f compose.dev.yml config",
    "compose:up": "docker compose --env-file .env.docker.example -f compose.yml -f compose.dev.yml up -d --wait mongodb neo4j redis influxdb tsa witness backend worker frontend",
    "compose:down": "docker compose --env-file .env.docker.example -f compose.yml -f compose.dev.yml down --volumes --remove-orphans",
    "compose:logs": "docker compose --env-file .env.docker.example -f compose.yml -f compose.dev.yml logs -f",
    "compose:ps": "docker compose --env-file .env.docker.example -f compose.yml -f compose.dev.yml ps",
    "build": "npm --prefix frontend run build && npm --prefix api/backend run current-state:ci",
    "lint": "npm --prefix frontend run lint && npm --prefix api/backend run lint",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix api/backend run typecheck"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "baseline-browser-mapping": "^2.9.16",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2",
    "vite-plugin-istanbul": "^8.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@influxdata/influxdb-client": "^1.35.0",
    "axios": "^1.15.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "fs": "^0.0.1-security",
    "ioredis": "^5.9.3",
    "lucide-react": "^1.8.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.2.3",
    "neo4j-driver": "^6.0.1",
    "node-cron": "^4.2.1",
    "path": "^0.12.7",
    "react-hook-form": "^7.72.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.14.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "shelljs": "^0.10.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  }
}
