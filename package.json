{
  "scripts": {
    "audit:full": "node scripts/audit-complete-system.js",
    "seed": "node scripts/seed.js",
    "build": "vite build",
    "backend:user:check": "npm --prefix backend run user:check",
    "backend:user:create-admin": "npm --prefix backend run user:create-admin",
    "dev:up": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.override.yml up -d backend frontend",
    "dev:down": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.override.yml down",
    "dev:logs": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.override.yml logs -f backend frontend",
    "dev:ps": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.override.yml ps",
    "dev": "vite",
    "docker:local:up": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-stack.ps1 -EnvFile .env.docker -ComposeFile docker-compose.yml -SkipMigration",
    "docker:local:up:migrate": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-stack.ps1 -EnvFile .env.docker -ComposeFile docker-compose.yml",
    "docker:local:down": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local-stack.ps1 -EnvFile .env.docker -ComposeFile docker-compose.yml",
    "docker:local:logs": "docker compose --env-file .env.docker -f docker-compose.yml logs -f",
    "docker:local:ps": "docker compose --env-file .env.docker -f docker-compose.yml ps",
    "docker:test:backend": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.test.yml run --rm backend-test",
    "docker:test:frontend": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.test.yml run --rm frontend-test",
    "lab:test": "npm --prefix backend run lab:test",
    "preview": "vite preview",
    "test:browser": "vitest",
    "test:browser:watch": "vitest --watch",
    "test:browser:run": "vitest run"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "baseline-browser-mapping": "^2.9.16",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@influxdata/influxdb-client": "^1.35.0",
    "axios": "^1.15.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "fs": "^0.0.1-security",
    "ioredis": "^5.9.3",
    "lucide-react": "^1.8.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.2.3",
    "neo4j-driver": "^6.0.1",
    "node-cron": "^4.2.1",
    "path": "^0.12.7",
    "react-hook-form": "^7.72.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.14.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "shelljs": "^0.10.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  }
}
