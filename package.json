    "axios": "^1.15.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "fs": "^0.0.1-security",
    "ioredis": "^5.9.3",
    "lucide-react": "^1.8.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.2.3",
    "neo4j-driver": "^6.0.1",
    "node-cron": "^4.2.1",
    "path": "^0.12.7",
    "react-hook-form": "^7.72.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.14.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "shelljs": "^0.10.0",
