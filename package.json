{
  "scripts": {
    "audit:full": "node scripts/system-audit-full.js",
    "seed": "npm --prefix api/backend run seed:essential",
    "build": "vite build",
    "backend:admin:create-first": "npm --prefix api/backend run admin:create-first",
    "backend:user:create-admin": "npm --prefix api/backend run admin:create-first",
    "compose:config": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml config",
    "compose:up": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml up -d --wait mongodb-test neo4j-test redis-test influxdb-test mqtt-test smtp-test tsa-test witness-test backend-app-test worker-test frontend-app-test",
    "compose:down": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml down --volumes --remove-orphans",
    "compose:reset": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml down --volumes --remove-orphans",
    "compose:logs": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml logs -f",
    "compose:ps": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml ps",
    "compose:smoke": "bash scripts/deploy/compose-smoke-test.sh",
    "dev:up": "npm run compose:up",
    "dev:down": "npm run compose:down",
    "dev:logs": "docker compose --env-file .env.test -f docker-compose.test.yml logs -f backend-app-test frontend-app-test",
    "dev:ps": "npm run compose:ps",
    "dev": "vite",
    "docker:local:up": "npm run compose:up",
    "docker:local:up:migrate": "npm run compose:up",
    "docker:local:down": "npm run compose:down",
    "docker:local:logs": "npm run compose:logs",
    "docker:local:ps": "npm run compose:ps",
    "docker:test:backend": "docker compose --env-file .env.test -f docker-compose.test.yml run --rm backend-unit-runner",
    "docker:test:frontend": "docker compose --env-file .env.test -f docker-compose.test.yml run --rm frontend-unit-runner",
    "test:stack:config": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml config --quiet",
    "test:stack:build": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml build",
    "test:stack:up": "npm run compose:up",
    "test:stack:reset": "npm run seed",
    "test:stack:seed": "npm run seed",
    "test:stack:backend": "npm --prefix api/backend run test:ci",
    "test:stack:e2e": "npm --prefix frontend run test:e2e",
    "test:stack:cleanup": "npm run compose:down",
    "test:stack:down": "node scripts/run-docker-compose.js --env-file .env.test -f docker-compose.test.yml down --volumes --remove-orphans",
    "lab:test": "npm --prefix api/backend run lab:test",
    "preview": "vite preview",
    "test:browser": "vitest",
    "test:browser:watch": "vitest --watch",
    "test:browser:run": "vitest run",
    "test:unit": "npm --prefix api/backend run test:ci && npm --prefix frontend run test:unit:coverage",
    "test:integration": "npm run docker:test:backend",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:poc": "echo 'POC workflow removed in favor of real validation stack.'",
    "test:poc:report": "echo 'POC workflow removed in favor of real validation stack.'"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.2",
    "baseline-browser-mapping": "^2.9.16",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "^4.0.7"
  },
  "dependencies": {
