{
  "scripts": {
    "audit:full": "node scripts/system-audit-full.js",
    "seed": "npm --prefix api/backend run seed:essential",
    "build": "vite build",
    "backend:admin:create-first": "npm --prefix api/backend run admin:create-first",
    "backend:user:create-admin": "npm --prefix api/backend run admin:create-first",
    "compose:config": "docker compose --env-file .env.docker -f docker-compose.yml config",
    "compose:up": "docker compose --env-file .env.docker -f docker-compose.yml up --build -d",
    "compose:down": "docker compose --env-file .env.docker -f docker-compose.yml down",
    "compose:reset": "docker compose --env-file .env.docker -f docker-compose.yml down --volumes --remove-orphans",
    "compose:logs": "docker compose --env-file .env.docker -f docker-compose.yml logs -f",
    "compose:ps": "docker compose --env-file .env.docker -f docker-compose.yml ps",
    "compose:smoke": "bash scripts/deploy/compose-smoke-test.sh",
    "dev:up": "npm run compose:up",
    "dev:down": "npm run compose:down",
    "dev:logs": "docker compose --env-file .env.docker -f docker-compose.yml logs -f backend frontend",
    "dev:ps": "npm run compose:ps",
    "dev": "vite",
    "docker:local:up": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-stack.ps1 -EnvFile .env.docker -ComposeFile docker-compose.yml -SkipMigration",
    "docker:local:up:migrate": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-stack.ps1 -EnvFile .env.docker -ComposeFile docker-compose.yml",
    "docker:local:down": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local-stack.ps1 -EnvFile .env.docker -ComposeFile docker-compose.yml",
    "docker:local:logs": "npm run compose:logs",
    "docker:local:ps": "npm run compose:ps",
    "docker:test:backend": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.test.yml run --rm backend-test",
    "docker:test:frontend": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.test.yml run --rm frontend-test",
    "lab:test": "npm --prefix api/backend run lab:test",
    "preview": "vite preview",
    "test:browser": "vitest",
    "test:browser:watch": "vitest --watch",
    "test:browser:run": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts --coverage tests/poc/unit",
    "test:integration": "vitest run --config vitest.config.ts --coverage tests/poc/integration",
    "test:e2e": "npm --prefix frontend run test:e2e -- --config ../playwright.config.ts",
    "test:poc": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:poc:report": "npm run test:poc && node tests/poc/utils/generate-poc-report.js"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.2",
    "baseline-browser-mapping": "^2.9.16",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@influxdata/influxdb-client": "^1.35.0",
    "axios": "^1.15.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "fs": "^0.0.1-security",
    "ioredis": "^5.9.3",
    "lucide-react": "^1.8.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.2.3",
    "neo4j-driver": "^6.0.1",
    "node-cron": "^4.2.1",
    "path": "^0.12.7",
    "react-hook-form": "^7.72.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.14.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "shelljs": "^0.10.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  }
}
