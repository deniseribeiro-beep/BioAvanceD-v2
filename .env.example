# ==============================
# BioAvanceD - Local development
# ==============================

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
ENCRYPTION_KEY=change-me-32-char-key
USER_ANON_SALT=change-me-salt

# CORS / URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_URL=http://localhost:3000
CORS_ALLOW_ALL=false

# ---------- MongoDB ----------
MONGO_URI=mongodb://mongodb:27017/bioavanced
MONGO_DB=bioavanced
MONGO_DB_NOVO=bioavanced_novo

# ---------- Neo4j ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false

# ---------- InfluxDB ----------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=bioavanced-influx-token
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=temperature

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_USERNAME=default
REDIS_TLS=false

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:3000

# ---------- Docker Compose init vars ----------
COMPOSE_PROJECT_NAME=bioavanced
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin12345