# ================================================
# BioAvanceD Backend - Strict Resilience Profile
# For regulated environments (fail-closed baseline)
# ================================================

# Topological lineage baseline mode
# fail-closed = strict mode globally (blocks on Neo4j/consent failures)
LINEAGE_MODE=fail-closed

# -------------------------------
# Topological Quarantine (Redis)
# -------------------------------
# Even in strict mode this can be useful for non-critical async retries.
NEO4J_RETRY_QUEUE_KEY=neo4j_retry_queue
NEO4J_RETRY_INTERVAL_MS=30000
NEO4J_RETRY_BATCH_SIZE=20
NEO4J_RETRY_MAX_ATTEMPTS=50

# -------------------------------
# Telemetry Monitor (Influx -> Neo4j)
# -------------------------------
TELEMETRY_MONITOR_CRON=*/5 * * * *
TELEMETRY_CRITICAL_TEMP=-80
TELEMETRY_CRITICAL_DURATION_HOURS=2
TELEMETRY_LOOKBACK_HOURS=4
TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30

# -------------------------------
# Unified Notifications (Resend)
# -------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=
ALERT_EMAIL_TO=

# -------------------------------
# Neo4j startup behavior
# -------------------------------
# In strict regulated mode, keep true to avoid startup without Neo4j.
NEO4J_REQUIRED=true

# -------------------------------
# Consent sync scheduler (optional)
# -------------------------------
ENABLE_CONSENT_SYNC=true
CONSENT_SYNC_CRON=*/30 * * * *
CONSENT_SYNC_BATCH_SIZE=500

# ==================================================
# Environment presets (copy only the block you need)
# ==================================================

# [DEV] - estrito para testes de bloqueio e rollback
# LINEAGE_MODE=fail-closed
# NEO4J_REQUIRED=true
# NEO4J_RETRY_INTERVAL_MS=20000
# TELEMETRY_MONITOR_CRON=*/10 * * * *
# TELEMETRY_TRIGGER_COOLDOWN_MINUTES=10

# [HOMOLOG] - validação regulatória pré-produção
# LINEAGE_MODE=fail-closed
# NEO4J_REQUIRED=true
# NEO4J_RETRY_INTERVAL_MS=30000
# NEO4J_RETRY_BATCH_SIZE=20
# TELEMETRY_MONITOR_CRON=*/5 * * * *
# TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30

# [PROD] - operação regulada fail-closed
# LINEAGE_MODE=fail-closed
# NEO4J_REQUIRED=true
# NEO4J_RETRY_INTERVAL_MS=30000
# NEO4J_RETRY_BATCH_SIZE=20
# NEO4J_RETRY_MAX_ATTEMPTS=200
# TELEMETRY_MONITOR_CRON=*/5 * * * *
# TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30
