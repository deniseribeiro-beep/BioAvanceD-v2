{
  "$id": "http://hl7.org/fhir/R4/Bundle",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FHIR R4 Bundle",
  "type": "object",
  "required": ["resourceType", "entry"],
  "properties": {
    "resourceType": { "const": "Bundle" },
    "type": { "type": "string" },
    "entry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": { "type": "object" }
        },
        "required": ["resource"]
      }
    }
  },
  "additionalProperties": true
}
