# ========================================
# BioAvanceD Backend - Resilience Profile
# Recommended values for production baseline
# ========================================

# Topological lineage baseline mode
# fail-open  = permissive fallback + quarantine queue
# fail-closed = strict mode globally
LINEAGE_MODE=fail-open

# -------------------------------
# Topological Quarantine (Redis)
# -------------------------------
NEO4J_RETRY_QUEUE_KEY=neo4j_retry_queue
NEO4J_RETRY_INTERVAL_MS=30000
NEO4J_RETRY_BATCH_SIZE=20
NEO4J_RETRY_MAX_ATTEMPTS=50

# -------------------------------
# Telemetry Monitor (Influx -> Neo4j)
# -------------------------------
TELEMETRY_MONITOR_CRON=*/5 * * * *
TELEMETRY_CRITICAL_TEMP=-80
TELEMETRY_CRITICAL_DURATION_HOURS=2
TELEMETRY_LOOKBACK_HOURS=4
TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30

# -------------------------------
# Optional Neo4j behavior flags
# -------------------------------
# Keep false if you want backend to boot even when Neo4j is temporarily down.
NEO4J_REQUIRED=false

# -------------------------------
# Consent sync scheduler (optional)
# -------------------------------
ENABLE_CONSENT_SYNC=true
CONSENT_SYNC_CRON=*/30 * * * *
CONSENT_SYNC_BATCH_SIZE=500

# ==================================================
# Environment presets (copy only the block you need)
# ==================================================

# [DEV] - foco em continuidade local
# LINEAGE_MODE=fail-open
# NEO4J_REQUIRED=false
# NEO4J_RETRY_INTERVAL_MS=15000
# TELEMETRY_MONITOR_CRON=*/10 * * * *
# TELEMETRY_TRIGGER_COOLDOWN_MINUTES=10

# [HOMOLOG] - comportamento próximo de produção
# LINEAGE_MODE=fail-open
# NEO4J_REQUIRED=true
# NEO4J_RETRY_INTERVAL_MS=30000
# TELEMETRY_MONITOR_CRON=*/5 * * * *
# TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30

# [PROD] - baseline permissivo com rastreabilidade forte
# LINEAGE_MODE=fail-open
# NEO4J_REQUIRED=true
# NEO4J_RETRY_INTERVAL_MS=30000
# NEO4J_RETRY_BATCH_SIZE=20
# NEO4J_RETRY_MAX_ATTEMPTS=200
# TELEMETRY_MONITOR_CRON=*/5 * * * *
# TELEMETRY_TRIGGER_COOLDOWN_MINUTES=30
