{
  "name": "bioavanced-backend",
  "version": "1.0.0",
  "description": "Backend API para sistema de gerenciamento de amostras biológicas - BioAvanceD",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node ./src/workers/worker.js",
    "worker:dev": "nodemon ./src/workers/worker.js",
    "create-db": "node scripts/create-db.js",
    "fix-admin": "node scripts/fix-admin-role.js",
    "sync-collections": "node scripts/sync-collections.js",
    "audit": "node scripts/audit-database.js",
    "audit:frontend": "node scripts/audit-frontend-backend.js",
    "test:mongo": "node scripts/test-connection-mongo.js",
    "test:connections": "node scripts/test-connections.js",
    "setup": "node setup-env.js",
    "reset-admin": "node scripts/reset-admin-first-login.js",
    "find-port": "node scripts/find-port.js",
    "kill-port": "node scripts/kill-port.js",
    "check-ports": "node scripts/check-ports.js",
    "cleanup": "node ../scripts/cleanup-complete.js",
    "clean": "node ../scripts/cleanup-complete.js",
    "test:redis": "node scripts/test-redis-connection.js",
    "test": "node test/run-tests.js",
    "test:security": "node test/unit/security.test.js",
    "test:consent": "node test/unit/authConsent.test.js",
    "test:unit": "node test/unit/run-tests.js && node test/unit/authConsent.test.js",
    "test:ci": "node test/run-tests.js && node test/integrityCheckService.mock.test.js && node test/integration/auditRoot.service.mock.test.js && node test/unit/run-tests.js && node test/unit/authConsent.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "argon2": "^0.31.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^3.16.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "fhir-kit-client": "^1.3.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^6.0.1",
    "mongodb": "^6.3.0",
    "mongoose": "^9.2.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "@influxdata/influxdb-client": "^1.35.0",
    "nodemailer": "^7.0.11",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.8.1",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
