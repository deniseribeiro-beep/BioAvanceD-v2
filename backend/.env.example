NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://localhost:27017/bioavanced
MONGO_DB=bioavanced
MONGO_DB_NOVO=bioavanced_novo

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
