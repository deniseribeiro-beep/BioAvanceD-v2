NODE_ENV=development
PORT=3000

# MongoDB local/container
MONGO_ROOT_USERNAME=<mongo-root-user>
MONGO_ROOT_PASSWORD=<mongo-root-password>
MONGO_DB=bioavanced_dev
MONGO_DB_NOVO=bioavanced_dev
MONGO_URI=mongodb://<mongo-root-user>:<mongo-root-password>@mongodb:27017/bioavanced_dev?authSource=admin

# Auth and crypto
JWT_SECRET=<change-me>
JWT_REFRESH_SECRET=<change-me>
ENCRYPTION_KEY=<32-plus-character-dev-key>
ENCRYPTION_KEY_ID=dev-key-1
USER_ANON_SALT=<change-me>

# Neo4j local/container
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<neo4j-password>
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false
LINEAGE_MODE=fail-open
NEO4J_CONNECT_MAX_RETRIES=12
NEO4J_CONNECT_INITIAL_DELAY_MS=1000
NEO4J_CONNECT_MAX_DELAY_MS=10000

# Redis local/container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_TLS=false

# InfluxDB local/container
INFLUXDB_INIT_USERNAME=<influx-user>
INFLUXDB_INIT_PASSWORD=<influx-password>
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=bioavanced_telemetry
INFLUXDB_TOKEN=<influx-token>
INFLUXDB_URL=http://influxdb:8086

# External/cloud integrations: keep disabled for Docker audit
MQTT_ENABLED=false
MQTT_URL=
MQTT_TLS_ENABLED=false
ALLOW_CLOUD_INTEGRATIONS=false
ALLOW_EXTERNAL_TERMINOLOGY_SYNC=false
ALLOW_EXTERNAL_HPO_LOOKUP=false
ALLOW_EXTERNAL_DRUG_LOOKUP=false

# URLs and CORS
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
TRUST_PROXY=1

# Vite
VITE_API_BASE_URL=http://localhost:3000
VITE_HMR_HOST=localhost
VITE_HMR_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=5173

# Resend is the only permitted external integration.
# Leave RESEND_API_KEY empty to use development/mock behavior where supported.
APP_DOMAIN=localhost
ALERT_EMAIL_TO=
RESEND_API_KEY=
EMAIL_FROM=BioAvanceD Dev <noreply@localhost>
