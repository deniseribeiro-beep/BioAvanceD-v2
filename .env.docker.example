NODE_ENV=development
PORT=3000
# Explicit, isolated opt-in for authLimiter's relaxed /api/auth budget
# (#359, RNF008.6) -- this compose stack is the "controlled suite" that
# needs it so a real-backend e2e spec file doing several logins/2FA calls
# per minute doesn't 429 (#350). Leave unset anywhere NODE_ENV alone
# shouldn't be enough to relax an authentication control.
AUTH_RATE_LIMIT_RELAXED=true

# Optional host port overrides
BACKEND_HOST_PORT=3000
BACKEND_DEBUG_HOST_PORT=9229
FRONTEND_HOST_PORT=5173
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
INFLUXDB_HOST_PORT=8086

# MongoDB
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DB=bioavanced_dev
MONGO_DB_NOVO=bioavanced_dev
MONGO_URI=mongodb://mongodb:27017/bioavanced_dev

# Authentication and cryptography
JWT_SECRET=
JWT_REFRESH_SECRET=
CONSENT_SECRET=
# ENCRYPTION_KEY is load-bearing, and leaving it blank does NOT merely
# disable an optional feature (#937, #938):
#   - file uploads (sample-file and linked scientific files) are REFUSED
#     with a 500 since #938 -- they used to be written to disk in
#     plaintext and still return success, which is the defect that fix
#     removed. Set ALLOW_UNENCRYPTED_FILE_STORAGE=true to deliberately
#     accept plaintext storage instead (dev only);
#   - backups FAIL outright since #734, because the backup policy's
#     encryptionEnabled defaults to true and a backup that believes it is
#     encrypted must not silently produce plaintext.
# Set a 32-byte value. See .env.test.example for the shape.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=dev-key-1
AUDIT_MERKLE_SIGN_KEY_ID=audit-ed25519-dev-1
AUDIT_MERKLE_SIGN_PRIVATE_KEY_FILE=/run/secrets/merkle_signing_key.pem
AUDIT_MERKLE_SIGN_PUBLIC_KEYS_JSON={}
AUDIT_RFC3161_MODE=remote
AUDIT_RFC3161_TSA_URL=http://tsa:8095/tsa
AUDIT_RFC3161_TSA_AUTH_TOKEN=
AUDIT_EXTERNAL_WITNESS_URL=http://witness:8096/witness
AUDIT_EXTERNAL_WITNESS_PUBLIC_KEY=
USER_ANON_SALT=
# Shared secret required by the test-support-only IoT/ingestion routes
# (#307/#669, api/backend/src/interface/routes/iot.routes.js and
# ingestionTestSupport.routes.js). Leave unset to keep those routes
# fail-closed even though NODE_ENV isn't "production" here.
TEST_SUPPORT_SECRET=
# Explicit, isolated opt-in required for those same test-support routes to
# even be *registered* (#675) -- NODE_ENV alone was never enough on its
# own (nothing in this repo enforces NODE_ENV=production in a real
# deployment), so registration now needs this flag too, same
# "controlled-suite-only" shape as AUTH_RATE_LIMIT_RELAXED above. Leave
# unset anywhere this attack surface shouldn't exist at all.
ENABLE_TEST_SUPPORT_ROUTES=

# First-admin bootstrap (#344): the compose.yml/compose.dev.yml stack has no
# users on a fresh volume. Bootstrap is deliberately manual (README's
# "Bootstrap and Seeds" section) — run `npm run compose:seed-admin` once the
# stack is up to create this account via createFirstAdmin.js. Matches
# compose.test.yml's TEST_USER/TEST_PASS (admin/Admin@123) so
# `npm run test:e2e:docker` can log in against either stack unchanged.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@bioavanced.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_TEMP_PASSWORD=Admin@123

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false
LINEAGE_MODE=fail-open
NEO4J_CONNECT_MAX_RETRIES=12
NEO4J_CONNECT_INITIAL_DELAY_MS=1000
NEO4J_CONNECT_MAX_DELAY_MS=10000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_TLS=false

# Import worker (#971). Deliberately 1: the import duplicate checks are
# read-then-write with no unique index behind participants, so two concurrent
# jobs can each insert the same person. Raising this trades that safety for
# import throughput -- do not, until the participant identity key is indexed.
WORKER_CONCURRENCY=1

# InfluxDB
INFLUXDB_INIT_USERNAME=
INFLUXDB_INIT_PASSWORD=
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=bioavanced_telemetry
INFLUXDB_TOKEN=
INFLUXDB_URL=http://influxdb:8086

# External integrations
MQTT_ENABLED=false
MQTT_URL=
MQTT_TLS_ENABLED=false
ALLOW_CLOUD_INTEGRATIONS=false
ALLOW_EXTERNAL_TERMINOLOGY_SYNC=false
ALLOW_EXTERNAL_HPO_LOOKUP=false
ALLOW_EXTERNAL_DRUG_LOOKUP=false

# URLs and CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
TRUST_PROXY=1

# Vite
VITE_API_BASE_URL=http://localhost:3000
VITE_HMR_HOST=localhost
VITE_HMR_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=5173

# Email
APP_DOMAIN=localhost
ALERT_EMAIL_TO=
RESEND_API_KEY=
EMAIL_FROM="BioAvanceD Dev <noreply@localhost>"

# Writable storage roots (#893): only load-bearing on the read_only:true prod
# stack (see .env.production.example) -- this dev/e2e stack's containers are
# writable, so the code defaults (uncommented) are fine left as-is.
#UPLOAD_DIR=/app/uploads
#STORAGE_DIR=/app/storage

# Scheduled jobs (#754)
# initScheduler() runs unconditionally from server.js#startServer -- there is
# no NODE_ENV gate -- so these fire wherever the backend runs. All values are
# node-cron expressions; each line below shows the code's own default, so
# leaving them commented out preserves current behaviour.
#
# TZ is the timezone EVERY expression above is interpreted in. Set it before
# tuning any of the times below, or "3am" will not be the 3am you meant.
#TZ=America/Sao_Paulo
#
# Nightly database backup. Note this is the boot-time value only: once a
# BackupPolicy row exists, its cronExpression takes over at runtime (#728),
# and BACKUP_CRON is the fallback used when the policy lookup fails.
#BACKUP_CRON=0 3 * * *
#
# Retention sweep -- applies RetentionPolicy dispositions.
#RETENTION_SWEEP_CRON=0 4 * * *
#
# Sandboxed restore test (#731): restores the latest backup into a scratch
# database to prove backups are actually restorable. Weekly, Sundays.
#RESTORE_TEST_CRON=0 5 * * 0
#
# Stale-temperature-reading check. TEMP_STALE_MINUTES is how old a reading
# must be before it counts as stale.
#TEMP_MONITOR_CRON=*/10 * * * *
#TEMP_STALE_MINUTES=20
#
# Telemetry excursion detection. Read directly from process.env by
# TelemetryMonitor, not through src/config/env.js like the others.
#TELEMETRY_MONITOR_CRON=*/5 * * * *
