NODE_ENV=development
PORT=3000
# Explicit, isolated opt-in for authLimiter's relaxed /api/auth budget
# (#359, RNF008.6) -- this compose stack is the "controlled suite" that
# needs it so a real-backend e2e spec file doing several logins/2FA calls
# per minute doesn't 429 (#350). Leave unset anywhere NODE_ENV alone
# shouldn't be enough to relax an authentication control.
# #1162: generate-env-docker-secrets.sh writes this BLANK (off), in a fresh
# generate and on --upgrade alike. Set it to true in .env.docker by hand
# when you point a Playwright run at this dev stack. compose.test.yml, the
# e2e stack, needs neither flag (NODE_ENV=test mounts no limiter).
AUTH_RATE_LIMIT_RELAXED=true
# The same opt-in for consentLimiter's budget on the six UNAUTHENTICATED
# e-consent token routes (#823, #832). Separate from the flag above on
# purpose -- they relax different controls. This stack needs it because
# participant-e-consent-page.spec.ts drives several validate/update calls
# per minute against a real backend. Leave unset anywhere the participant
# consent surface shouldn't be relaxed. Generated BLANK too (#1162).
CONSENT_RATE_LIMIT_RELAXED=true

# Optional host port overrides
BACKEND_HOST_PORT=3000
BACKEND_DEBUG_HOST_PORT=9229
FRONTEND_HOST_PORT=5173
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
INFLUXDB_HOST_PORT=8086

# MongoDB
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DB=bioavanced_dev
MONGO_DB_NOVO=bioavanced_dev
MONGO_URI=mongodb://mongodb:27017/bioavanced_dev

# Authentication and cryptography
JWT_SECRET=
JWT_REFRESH_SECRET=
CONSENT_SECRET=
# ENCRYPTION_KEY is load-bearing, and leaving it blank does NOT merely
# disable an optional feature (#937, #938):
#   - file uploads (sample-file and linked scientific files) are REFUSED
#     with a 500 since #938 -- they used to be written to disk in
#     plaintext and still return success, which is the defect that fix
#     removed. Set ALLOW_UNENCRYPTED_FILE_STORAGE=true to deliberately
#     accept plaintext storage instead (dev only);
#   - participant and biomarker writes carrying a sensitive FIELD
#     (representativeIdentityDocument, biomarker value) are REFUSED with a
#     500 since #1083 -- they used to be stored in plaintext and still
#     return success, which is the same defect one layer down. Set
#     ALLOW_UNENCRYPTED_FIELD_STORAGE=true to deliberately accept plaintext
#     fields instead (dev only);
#   - backups FAIL outright since #734, because the backup policy's
#     encryptionEnabled defaults to true and a backup that believes it is
#     encrypted must not silently produce plaintext.
# Set a 32-byte value. See .env.test.example for the shape.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=dev-key-1
#
# #1086: ENCRYPTION_KEY can be rotated without a code change (RNF020 AC#5).
# The previous key stays readable while it is parked here -- it is
# DECRYPT-ONLY (isActive: false), so filling it in never makes a stack with a
# blank ENCRYPTION_KEY start encrypting again. Rotation, in order:
#   1. move the current pair into ENCRYPTION_KEY_PREVIOUS / _PREVIOUS_ID
#   2. put the new pair into ENCRYPTION_KEY / ENCRYPTION_KEY_ID
#   3. restart -- new envelopes use the new key, old ones still decrypt
# The previous key needs its OWN id: an id equal to ENCRYPTION_KEY_ID, or a
# key with no id at all, is discarded (and warned about at boot).
#
# Step 4 (#1103): from api/backend, `npm run encryption:rewrite -- --apply`
# re-encrypts every field in utils/encryptedFieldRegistry.js under the new
# key and re-derives the blind indexes. Then run `npm run encryption:rewrite`
# (a dry run) and empty this slot only when it prints
# "safeToEmptyPreviousSlot": true. Anything else means data still needs the
# old key, and emptying the slot is IRREVERSIBLE for it:
#   - envelopes stamped with the old keyId stop decrypting. They return
#     null, silently, per field -- not an error;
#   - and since #1099 the blind indexes go with them. identityDocumentHash
#     and birthDateHash are matched under every REGISTERED key, so a value
#     indexed before the rotation becomes unmatchable once the slot is
#     emptied, and a missed identity match creates a DUPLICATE participant
#     rather than raising an error.
# The dry run also counts file rows (encryptionKeyId) under the old key.
# The rewrite does not re-encrypt file binaries, so while any remain the
# verdict stays false and the slot stays filled.
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=
AUDIT_MERKLE_SIGN_KEY_ID=audit-ed25519-dev-1
AUDIT_MERKLE_SIGN_PRIVATE_KEY_FILE=/run/secrets/merkle_signing_key.pem
# Registro de chaves PÚBLICAS usado para VERIFICAR raízes assinadas. Um {} aqui
# não é neutro: getPublicKeyPem devolve null, toda raiz é selada com
# publicKeyFingerprint null e processTimestampBacklog carimba
# FAILED/signature_unknown_key_id -- ou seja, o stack assina corretamente e
# declara os próprios artefatos inválidos (#1157). generate-env-docker-secrets.sh
# preenche esta variável com a metade SPKI da chave que ele mesmo gera.
AUDIT_MERKLE_SIGN_PUBLIC_KEYS_JSON={}
# #1157: alternativa em ARQUIVO à variável acima, e a de maior precedência.
# Existe porque o registro precisa conter a metade pública de uma chave que só
# nasce quando o stack sobe, e o compose resolve seu environment em tempo de
# parse -- nenhuma entrada estática poderia carregá-la. O stack de teste aponta
# para o arquivo que audit-keygen-test escreve ao lado da chave privada, no
# mesmo volume. Deixe em branco para o stack de dev, que usa o gerador de host.
AUDIT_MERKLE_SIGN_PUBLIC_KEYS_FILE=
AUDIT_RFC3161_MODE=remote
AUDIT_RFC3161_TSA_URL=http://tsa:8095/tsa
AUDIT_RFC3161_TSA_AUTH_TOKEN=
AUDIT_EXTERNAL_WITNESS_URL=http://witness:8096/witness
AUDIT_EXTERNAL_WITNESS_PUBLIC_KEY=
USER_ANON_SALT=
# #1161: sal separado para a pseudonimização das projeções canônicas no Neo4j.
# Lido por config/env.js e neo4jCanonicalProjection.service.js através da cadeia
# NEO4J_CANONICAL_SALT -> GRAPH_PSEUDONYMIZATION_SALT -> USER_ANON_SALT, então
# deixar os dois em branco NÃO desliga nada: o sal de usuários é reutilizado em
# silêncio. generate-env-docker-secrets.sh gera um valor próprio para o primeiro.
# Declarados aqui porque o exemplo é a superfície declarada do stack -- antes de
# #1161 o gerador escrevia NEO4J_CANONICAL_SALT e nenhum dos dois arquivos o
# mencionava, então a existência do botão era indescobrível.
#
# ATENÇÃO ao esvaziar ou trocar: nós canônicos já projetados foram
# pseudonimizados sob o sal vigente na época e não são reescritos por nada neste
# repositório -- a mesma classe de pergunta que #1103 levanta para a rotação de
# chaves de criptografia.
NEO4J_CANONICAL_SALT=
GRAPH_PSEUDONYMIZATION_SALT=
# Shared secret required by the test-support-only IoT/ingestion routes
# (#307/#669, api/backend/src/interface/routes/iot.routes.js and
# ingestionTestSupport.routes.js). Leave unset to keep those routes
# fail-closed even though NODE_ENV isn't "production" here.
TEST_SUPPORT_SECRET=

# #1054: credential for machine/IoT telemetry ingest -- currently
# POST /api/temperature/system/reading, which was previously mounted with no
# middleware at all. FAILS CLOSED: leaving this unset does not make the route
# anonymous, it makes the route unavailable (utils/machineIngestGate.js, same
# rule #675 established for TEST_SUPPORT_SECRET). Set it only on a stack that
# actually has a sensor or gateway posting readings, and give the device the
# same value in an x-telemetry-ingest-secret header.
TELEMETRY_INGEST_SECRET=
# Explicit, isolated opt-in required for those same test-support routes to
# even be *registered* (#675) -- NODE_ENV alone was never enough on its
# own (nothing in this repo enforces NODE_ENV=production in a real
# deployment), so registration now needs this flag too, same
# "controlled-suite-only" shape as AUTH_RATE_LIMIT_RELAXED above. Leave
# unset anywhere this attack surface shouldn't exist at all.
ENABLE_TEST_SUPPORT_ROUTES=

# First-admin bootstrap (#344): the compose.yml/compose.dev.yml stack has no
# users on a fresh volume. Bootstrap is deliberately manual (README's
# "Bootstrap and Seeds" section) — run `npm run compose:seed-admin` once the
# stack is up to create this account via createFirstAdmin.js. Matches
# compose.test.yml's TEST_USER/TEST_PASS (admin/Admin@123-e2e-stack) so
# `npm run test:e2e:docker` can log in against either stack unchanged.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@bioavanced.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_TEMP_PASSWORD=Admin@123-e2e-stack

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false
LINEAGE_MODE=fail-open
# enforce (the default) refuses with 422 a reading whose sensor lacks a
# datastream, an active DeviceRegistration or a usable Device; record stores it
# and records a TelemetryValidationIssue.
TELEMETRY_BINDING_MODE=enforce
NEO4J_CONNECT_MAX_RETRIES=12
NEO4J_CONNECT_INITIAL_DELAY_MS=1000
NEO4J_CONNECT_MAX_DELAY_MS=10000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_TLS=false

# Import worker (#971). Deliberately 1: the import duplicate checks are
# read-then-write with no unique index behind participants, so two concurrent
# jobs can each insert the same person. Raising this trades that safety for
# import throughput -- do not, until the participant identity key is indexed.
WORKER_CONCURRENCY=1

# InfluxDB
INFLUXDB_INIT_USERNAME=
INFLUXDB_INIT_PASSWORD=
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=bioavanced_telemetry
INFLUXDB_TOKEN=
INFLUXDB_URL=http://influxdb:8086

# External integrations
MQTT_ENABLED=false
MQTT_URL=
MQTT_TLS_ENABLED=false
ALLOW_CLOUD_INTEGRATIONS=false
ALLOW_EXTERNAL_TERMINOLOGY_SYNC=false
ALLOW_EXTERNAL_HPO_LOOKUP=false
ALLOW_EXTERNAL_DRUG_LOOKUP=false

# URLs and CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
# #1162: 0, matching config/env.js's own default, because NOTHING in this repo
# sits in front of the backend. compose.dev.yml and compose.prod.yml both
# publish the backend port directly, and the only nginx here is the frontend
# service serving the built SPA -- frontend/nginx.conf contains no proxy_pass
# and no X-Forwarded-For.
#
# The value matters because app.js:35 does app.set("trust proxy",
# parseTrustProxy(env.TRUST_PROXY)), and parseTrustProxy("1") returns the
# INTEGER 1 -- so Express derives req.ip from a client-supplied
# X-Forwarded-For instead of from the socket. req.ip is what authLimiter and
# consentLimiter count against, so a spoofed header rotates the rate-limit
# bucket. Until #1153 this line reached no generated file; the sync is what
# made it live, which is why it is corrected here rather than tolerated.
#
# Set it to the real hop count only on a deployment that actually terminates
# TLS or load-balances in front of the backend, and then stop publishing the
# backend's own port: a client that reaches it directly can still send the
# header. The login source-address block (#1255) keys on req.ip too (#1269).
TRUST_PROXY=0

# Vite
VITE_API_BASE_URL=http://localhost:3000
VITE_HMR_HOST=localhost
VITE_HMR_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=5173

# Email
ALERT_EMAIL_TO=
RESEND_API_KEY=
EMAIL_FROM="BioAvanceD Dev <noreply@localhost>"

# Writable storage roots (#893): only load-bearing on the read_only:true prod
# stack (see .env.production.example) -- this dev/e2e stack's containers are
# writable, so the code defaults (uncommented) are fine left as-is.
#UPLOAD_DIR=/app/uploads
#STORAGE_DIR=/app/storage

# Scheduled jobs (#754)
# initScheduler() runs unconditionally from server.js#startServer -- there is
# no NODE_ENV gate -- so these fire wherever the backend runs. All values are
# node-cron expressions; each line below shows the code's own default, so
# leaving them commented out preserves current behaviour.
#
# TZ is the timezone EVERY expression above is interpreted in. Set it before
# tuning any of the times below, or "3am" will not be the 3am you meant.
#TZ=America/Sao_Paulo
#
# Nightly database backup. At boot and after each policy change the stored
# BackupPolicy's cronExpression is applied (#728, #1325). BACKUP_CRON is the
# default for a new policy row and the schedule used until the policy is
# read, or when there is no policy to read.
#BACKUP_CRON=0 3 * * *
#
# Retention sweep -- applies RetentionPolicy dispositions.
#RETENTION_SWEEP_CRON=0 4 * * *
#
# Sandboxed restore test (#731): restores the latest backup into a scratch
# database to prove backups are actually restorable. Weekly, Sundays.
#RESTORE_TEST_CRON=0 5 * * 0
#
# Stale-temperature-reading check. TEMP_STALE_MINUTES is how old a reading
# must be before it counts as stale.
#TEMP_MONITOR_CRON=*/10 * * * *
#TEMP_STALE_MINUTES=20
#
# Platform alerts (RNF015 C2, #1323, #1468): HTTP error rate (0-1), p95
# latency in ms, queue backlog, and the fraction (0-1) of memory and disk in
# use that open an episode; the cron is the check's cadence.
#PLATFORM_ALERT_CRON=*/5 * * * *
#ALERT_HTTP_ERROR_RATE=0.05
#ALERT_HTTP_P95_MS=2500
#ALERT_QUEUE_BACKLOG=100
#ALERT_MEMORY_RATIO=0.9
#ALERT_DISK_RATIO=0.9
#
# Telemetry excursion detection. Read directly from process.env by
# TelemetryMonitor, not through src/config/env.js like the others.
#TELEMETRY_MONITOR_CRON=*/5 * * * *
