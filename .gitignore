# =========================
# Dependencies
# =========================
node_modules/
backend/node_modules/
frontend/node_modules/

# =========================
# Environment and secrets
# =========================
.env
.env.*
!.env.example
!.env.*.example
.env*.local
.env.docker
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/

# =========================
# Logs
# =========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Build artifacts
# =========================
dist/
build/
coverage/
.cache/
.vite/
*.tsbuildinfo
frontend/dist/

# =========================
# Test and audit artifacts
# =========================
test-results/
frontend/test-results/
frontend/playwright-report/
playwright-report/
traces/
frontend/playwright/.auth/
backend/test-output.txt
test-output.txt
reports/
api/backend/COMPLIANCE_EVIDENCE.json
COMPLIANCE_EVIDENCE.json
backup_before_push.patch
backup_status_before_push.txt
artifacts/
*.zip
*.xlsx

# Orphanet raw seed sources are versioned to support reproducible CENAPAD builds.
!orpha-data-raw/
!orpha-data-raw/**
!orpha-data-raw/*.zip
!orpha-data-raw/*.xlsx
!orpha-data-raw/**/*.zip
!orpha-data-raw/**/*.xlsx

# =========================
# Runtime uploads and generated files
# =========================
backend/uploads/temp/*
!backend/uploads/temp/.gitkeep
api/backend/uploads/temp/*
!api/backend/uploads/temp/.gitkeep

# =========================
# Local runtime data (Docker volumes / databases)
# =========================
data/
api/backend/data/
*.sqlite3

# Keep only sanitized backend seed reference data
!api/backend/src/seeders/data/
api/backend/src/seeders/data/*
!api/backend/src/seeders/data/rcs-*.json
!api/backend/src/seeders/data/*.min.json

# =========================
# Backups and temporary exports
# =========================
backend/backups/
api/backend/backups/
*.tmp
*.bak

# Accidental terminal/output artifacts
titucional*

# =========================
# OS / IDE
# =========================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
.vercel
.venv/
