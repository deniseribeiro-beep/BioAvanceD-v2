[ tsa ]
default_tsa = tsa_config

[ tsa_config ]
serial = /var/lib/tsa/serial
crypto_device = builtin

signer_cert = /etc/tsa/certs/tsa.crt.pem
certs = /etc/tsa/certs/ca.crt.pem
signer_key = /run/secrets/tsa_key.pem
signer_digest = sha256
default_tsa = tsa_config

default_policy = 1.3.6.1.4.1.55555.1.1
digests = sha256, sha384, sha512

accuracy = secs:1
ordering = yes
tsa_name = yes
ess_cert_id_chain = yes
