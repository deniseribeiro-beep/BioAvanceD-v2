NODE_ENV=production
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_URI=
MONGO_DB=bioavanced
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
REDIS_URL=redis://redis:6379
INFLUXDB_INIT_USERNAME=bioavanced
INFLUXDB_INIT_PASSWORD=
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=bioavanced_telemetry
INFLUXDB_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=
CONSENT_SECRET=
# ENCRYPTION_KEY is load-bearing, and leaving it blank does NOT merely
# disable an optional feature (#937, #938):
#   - file uploads (sample-file and linked scientific files) are REFUSED
#     with a 500 since #938 -- they used to be written to disk in
#     plaintext and still return success, which is the defect that fix
#     removed. Set ALLOW_UNENCRYPTED_FILE_STORAGE=true to deliberately
#     accept plaintext storage instead (dev only);
#   - participant and biomarker writes carrying a sensitive FIELD
#     (representativeIdentityDocument, biomarker value) are REFUSED with a
#     500 since #1083 -- they used to be stored in plaintext and still
#     return success, which is the same defect one layer down. Set
#     ALLOW_UNENCRYPTED_FIELD_STORAGE=true to deliberately accept plaintext
#     fields instead (dev only);
#   - backups FAIL outright since #734, because the backup policy's
#     encryptionEnabled defaults to true and a backup that believes it is
#     encrypted must not silently produce plaintext.
# Set a 32-byte value. Required for RNF007 encryption at rest.
#
# #1085: since 0c40f7dd the backend and the import worker REFUSE TO START
# when this is blank and NODE_ENV=production -- both exit 1 on a [SECURITY]
# line. That is deliberate: a production stack that cannot encrypt must not
# come up quietly. ALLOW_UNENCRYPTED_FIELD_STORAGE=true is the explicit,
# loudly-warned opt-out if a keyless production stack is genuinely wanted.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=prod-key-1
#
# #1086: ENCRYPTION_KEY can be rotated without a code change (RNF020 AC#5).
# The previous key stays readable while it is parked here -- it is
# DECRYPT-ONLY (isActive: false), so filling it in never makes a stack with a
# blank ENCRYPTION_KEY start encrypting again. Rotation, in order:
#   1. move the current pair into ENCRYPTION_KEY_PREVIOUS / _PREVIOUS_ID
#   2. put the new pair into ENCRYPTION_KEY / ENCRYPTION_KEY_ID
#   3. restart -- new envelopes use the new key, old ones still decrypt
# The previous key needs its OWN id: an id equal to ENCRYPTION_KEY_ID, or a
# key with no id at all, is discarded (and warned about at boot).
#
# Step 4 (#1103): from api/backend, `npm run encryption:rewrite -- --apply`
# re-encrypts every field in utils/encryptedFieldRegistry.js under the new
# key and re-derives the blind indexes. Then run `npm run encryption:rewrite`
# (a dry run) and empty this slot only when it prints
# "safeToEmptyPreviousSlot": true. Anything else means data still needs the
# old key, and emptying the slot is IRREVERSIBLE for it:
#   - envelopes stamped with the old keyId stop decrypting. They return
#     null, silently, per field -- not an error;
#   - and since #1099 the blind indexes go with them. identityDocumentHash
#     and birthDateHash are matched under every REGISTERED key, so a value
#     indexed before the rotation becomes unmatchable once the slot is
#     emptied, and a missed identity match creates a DUPLICATE participant
#     rather than raising an error.
# The dry run also counts file rows (encryptionKeyId) under the old key.
# The rewrite does not re-encrypt file binaries, so while any remain the
# verdict stays false and the slot stays filled.
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=
USER_ANON_SALT=
RESEND_API_KEY=
EMAIL_FROM=
ALLOWED_ORIGINS=
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=3000

# Writable storage roots (#893): backend/worker run read_only:true here with
# no volume under /app, so uploads/storage must live on a mounted volume
# outside the install directory. Code defaults (uncommented) reproduce
# today's __dirname-relative paths, which are NOT writable under this
# hardening -- set both to a mounted path before going live.
# SET, not commented: compose.prod.yml uses this file as its env_file, so it is
# the production config rather than documentation. These three point at the
# volumes compose.prod.yml mounts (uploads_data, storage_data, backups_data),
# which is what lets backend and worker keep read_only:true. Leaving them unset
# restores the __dirname-relative defaults, which EROFS on the first upload.
UPLOAD_DIR=/data/uploads
STORAGE_DIR=/data/storage
# #893: backup.service.js falls back to /app/backups, equally unwritable, and
# .env.production.example never set this -- while the same file records that
# initScheduler() runs unconditionally from server.js#startServer with no
# NODE_ENV gate, so the nightly backup cron fires and fails.
BACKUP_DIR=/data/backups
# #948: where a restore stages its decrypted copy of a dump. Defaults to
# <BACKUP_DIR>/.restore-scratch, i.e. the backups volume, which is the point:
# it used to be os.tmpdir(), and /tmp here is a RAM-backed tmpfs. The five
# /tmp mounts in compose.prod.yml are now capped at size=64m -- that cap is
# only safe BECAUSE the scratch moved off /tmp, and 64m would fail a restore
# outright if it moved back. Set this only to point the scratch at a
# different DISK-backed volume; never at /tmp or any tmpfs.
#RESTORE_SCRATCH_DIR=/data/restore-scratch
# #1325 (RNF010 C1): off-site copy of each backup run to an S3-compatible
# bucket. All four of ENDPOINT, BUCKET, ACCESS_KEY_ID and SECRET_ACCESS_KEY
# set turns the copy on; none set keeps it off; only some set fails every
# backup run. REGION defaults to us-east-1. A run with encryption off is
# never sent off-site.
#BACKUP_OFFSITE_S3_ENDPOINT=
#BACKUP_OFFSITE_S3_BUCKET=
#BACKUP_OFFSITE_S3_REGION=
#BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
#BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=


# Scheduled jobs (#754)
# initScheduler() runs unconditionally from server.js#startServer -- there is
# no NODE_ENV gate -- so these fire wherever the backend runs. All values are
# node-cron expressions; each line below shows the code's own default, so
# leaving them commented out preserves current behaviour.
#
# TZ is the timezone EVERY expression above is interpreted in. Set it before
# tuning any of the times below, or "3am" will not be the 3am you meant.
#TZ=America/Sao_Paulo
#
# Nightly database backup. At boot and after each policy change the stored
# BackupPolicy's cronExpression is applied (#728, #1325). BACKUP_CRON is the
# default for a new policy row and the schedule used until the policy is
# read, or when there is no policy to read.
#BACKUP_CRON=0 3 * * *
#
# Retention sweep -- applies RetentionPolicy dispositions.
#RETENTION_SWEEP_CRON=0 4 * * *
#
# Sandboxed restore test (#731): restores the latest backup into a scratch
# database to prove backups are actually restorable. Weekly, Sundays.
#RESTORE_TEST_CRON=0 5 * * 0
#
# Stale-temperature-reading check. TEMP_STALE_MINUTES is how old a reading
# must be before it counts as stale.
#TEMP_MONITOR_CRON=*/10 * * * *
#TEMP_STALE_MINUTES=20
#
# Platform alerts (RNF015 C2, #1323, #1468): HTTP error rate (0-1), p95
# latency in ms, queue backlog, and the fraction (0-1) of memory and disk in
# use that open an episode; the cron is the check's cadence.
#PLATFORM_ALERT_CRON=*/5 * * * *
#ALERT_HTTP_ERROR_RATE=0.05
#ALERT_HTTP_P95_MS=2500
#ALERT_QUEUE_BACKLOG=100
#ALERT_MEMORY_RATIO=0.9
#ALERT_DISK_RATIO=0.9
#
# Telemetry excursion detection. Read directly from process.env by
# TelemetryMonitor, not through src/config/env.js like the others.
#TELEMETRY_MONITOR_CRON=*/5 * * * *

# =====================================================================
# #965: keys that compose.prod.yml's services need and this file did not
# carry. Every one below is absent from src/config/env.js's defaults, so
# leaving it out does NOT fall back to something sensible -- it produces a
# stack that boots and is silently missing a capability. The values here
# are in-container service names from compose.prod.yml and are correct as
# written; only the blanks are yours to fill.
# =====================================================================

# --- Neo4j client ---------------------------------------------------
# Without NEO4J_URI, assertNeo4jEnv throws, server.js:43-53 catches it, and
# LINEAGE_MODE defaults to fail-open -- so the backend boots with
# neo4jDriver = null, the graph is dead, and neo4j-projection-worker never
# drains the outbox. Silently.
NEO4J_URI=bolt://neo4j:7687
# Set NEO4J_REQUIRED=true to make that failure loud instead of fail-open.
NEO4J_REQUIRED=true
LINEAGE_MODE=fail-closed

# --- Telemetry binding (RF009 AC4, RF017 AC5) ------------------------
# enforce (the default) refuses with 422 a reading whose sensor has no
# TelemetryDatastream valid at its observedAt, no active DeviceRegistration, or
# whose Device is not registered, homologated and unretired (RF017 AC8); record
# stores it and records a TelemetryValidationIssue.
TELEMETRY_BINDING_MODE=enforce

# --- InfluxDB client ------------------------------------------------
# Telemetry writes have no endpoint without this.
INFLUXDB_URL=http://influxdb:8086

# --- Redis client ---------------------------------------------------
# REDIS_URL above is what the app reads; these two are validateEnv.js's
# separate check. Keep them in step with REDIS_URL.
# #965: production Redis requires auth -- compose.prod.yml passes this to
# redis-server --requirepass, and validateEnv.js:44 rejects a blank one
# outside development. The worker treats that rejection as fatal.
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false

# Import worker (#971). Deliberately 1: the import duplicate checks are
# read-then-write with no unique index behind participants, so two concurrent
# jobs can each insert the same person. Raising this trades that safety for
# import throughput -- do not, until the participant identity key is indexed.
WORKER_CONCURRENCY=1

# --- Audit chain (RNF012) -------------------------------------------
# Without the TSA URL, audit-tsa.service.js throws, audit-v2 swallows it,
# and EVERY audit event is recorded PENDING_TIMESTAMP forever -- while the
# tsa service that `backend` waits to be healthy is never called. #948 and
# #954 exist because this path is easy to have present and not working.
AUDIT_RFC3161_MODE=live
# #959: the /tsa and /witness path suffixes are required. Both servers answer
# POST on exactly those paths and 404 everything else, and audit-tsa.service.js
# fetches this URL verbatim -- a bare host:port yields tsa_http_404 and a
# permanently PENDING_TIMESTAMP chain, with no error that says why.
AUDIT_RFC3161_TSA_URL=http://tsa:8095/tsa
AUDIT_RFC3161_TSA_AUTH_TOKEN=
AUDIT_EXTERNAL_WITNESS_URL=http://witness:8096/witness
AUDIT_EXTERNAL_WITNESS_PUBLIC_KEY=
# Merkle root signing. Supply the PEM by FILE in production, not inline.
AUDIT_MERKLE_SIGN_KEY_ID=prod-merkle-1
AUDIT_MERKLE_SIGN_PRIVATE_KEY_FILE=
AUDIT_MERKLE_SIGN_PUBLIC_KEYS_JSON=

# --- Application URLs -----------------------------------------------
# NotificationService.getFrontendUrl() throws without this; it is what
# consent links are built from.
FRONTEND_URL=
CORS_ALLOW_ALL=false
# Set to 1 only when running behind a reverse proxy that sets
# X-Forwarded-For, or rate limiting keys on the proxy's own address. Then
# stop publishing the backend's own port: a client that reaches it directly
# can still send the header and choose req.ip, which the rate limits and the
# login source-address block (#1255) count against (#1269).
TRUST_PROXY=0

# --- Secondary Mongo database ---------------------------------------
# Not on the boot path -- only scripts and reference-imports use it, so a
# missing value fails at first use rather than at startup.
MONGO_DB_NOVO=

# --- External integrations: OFF in production unless deliberately on ---
ALLOW_CLOUD_INTEGRATIONS=false
ALLOW_EXTERNAL_TERMINOLOGY_SYNC=false
ALLOW_EXTERNAL_HPO_LOOKUP=false
ALLOW_EXTERNAL_DRUG_LOOKUP=false
MQTT_ENABLED=false
MQTT_URL=
MQTT_TLS_ENABLED=true

# --- Alerting -------------------------------------------------------
ALERT_EMAIL_TO=

# =====================================================================
# DELIBERATELY ABSENT, do not add:
#   ENABLE_TEST_SUPPORT_ROUTES, TEST_SUPPORT_SECRET

# #1054: credential for machine/IoT telemetry ingest -- currently
# POST /api/temperature/system/reading, which was previously mounted with no
# middleware at all. FAILS CLOSED: leaving this unset does not make the route
# anonymous, it makes the route unavailable (utils/machineIngestGate.js, same
# rule #675 established for TEST_SUPPORT_SECRET). Set it only on a stack that
# actually has a sensor or gateway posting readings, and give the device the
# same value in an x-telemetry-ingest-secret header.
TELEMETRY_INGEST_SECRET=
# These mount test-only routes. #682 tracks confirming they stay unset in
# the first real deployment; setting them here would defeat that check.
#   BOOTSTRAP_ADMIN_*
# The first administrator is created by a deliberate, hand-run script
# (`npm run admin:create-first`), not by env vars a compose file reads.
#   VITE_*
# Build-time arguments for the frontend image, not runtime env. The
# frontend runtime stage is nginx serving a static dist/, so its env_file
# is inert -- VITE_API_BASE_URL is baked in at build time via ARG.
# =====================================================================
