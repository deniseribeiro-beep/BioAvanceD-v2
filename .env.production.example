NODE_ENV=production
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_URI=
MONGO_DB=bioavanced
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
REDIS_URL=redis://redis:6379
INFLUXDB_INIT_USERNAME=bioavanced
INFLUXDB_INIT_PASSWORD=
INFLUXDB_ORG=bioavanced
INFLUXDB_BUCKET=bioavanced_telemetry
INFLUXDB_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=
CONSENT_SECRET=
# ENCRYPTION_KEY is load-bearing, and leaving it blank does NOT merely
# disable an optional feature (#937, #938):
#   - file uploads (sample-file and linked scientific files) are written
#     to disk in PLAINTEXT and still return success -- fileCrypto logs a
#     warning and the caller skips encryption;
#   - backups FAIL outright since #734, because the backup policy's
#     encryptionEnabled defaults to true and a backup that believes it is
#     encrypted must not silently produce plaintext.
# Set a 32-byte value. Required for RNF007 encryption at rest.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=prod-key-1
USER_ANON_SALT=
RESEND_API_KEY=
EMAIL_FROM=
APP_DOMAIN=
ALLOWED_ORIGINS=
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=3000

# Writable storage roots (#893): backend/worker run read_only:true here with
# no volume under /app, so uploads/storage must live on a mounted volume
# outside the install directory. Code defaults (uncommented) reproduce
# today's __dirname-relative paths, which are NOT writable under this
# hardening -- set both to a mounted path before going live.
# SET, not commented: compose.prod.yml uses this file as its env_file, so it is
# the production config rather than documentation. These three point at the
# volumes compose.prod.yml mounts (uploads_data, storage_data, backups_data),
# which is what lets backend and worker keep read_only:true. Leaving them unset
# restores the __dirname-relative defaults, which EROFS on the first upload.
UPLOAD_DIR=/data/uploads
STORAGE_DIR=/data/storage
# #893: backup.service.js falls back to /app/backups, equally unwritable, and
# .env.production.example never set this -- while the same file records that
# initScheduler() runs unconditionally from server.js#startServer with no
# NODE_ENV gate, so the nightly backup cron fires and fails.
BACKUP_DIR=/data/backups


# Scheduled jobs (#754)
# initScheduler() runs unconditionally from server.js#startServer -- there is
# no NODE_ENV gate -- so these fire wherever the backend runs. All values are
# node-cron expressions; each line below shows the code's own default, so
# leaving them commented out preserves current behaviour.
#
# TZ is the timezone EVERY expression above is interpreted in. Set it before
# tuning any of the times below, or "3am" will not be the 3am you meant.
#TZ=America/Sao_Paulo
#
# Nightly database backup. Note this is the boot-time value only: once a
# BackupPolicy row exists, its cronExpression takes over at runtime (#728),
# and BACKUP_CRON is the fallback used when the policy lookup fails.
#BACKUP_CRON=0 3 * * *
#
# Retention sweep -- applies RetentionPolicy dispositions.
#RETENTION_SWEEP_CRON=0 4 * * *
#
# Sandboxed restore test (#731): restores the latest backup into a scratch
# database to prove backups are actually restorable. Weekly, Sundays.
#RESTORE_TEST_CRON=0 5 * * 0
#
# Stale-temperature-reading check. TEMP_STALE_MINUTES is how old a reading
# must be before it counts as stale.
#TEMP_MONITOR_CRON=*/10 * * * *
#TEMP_STALE_MINUTES=20
#
# Telemetry excursion detection. Read directly from process.env by
# TelemetryMonitor, not through src/config/env.js like the others.
#TELEMETRY_MONITOR_CRON=*/5 * * * *
