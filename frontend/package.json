{
  "name": "bioavanced-frontend",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de amostras biológicas e pacientes - BioAvanceD",
  "private": true,
  "type": "module",
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.5",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-barcode": "^1.4.1",
    "react-datamatrix-svg": "^1.0.7",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "socket.io-client": "^4.8.1",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "rollup": "^4.59.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "typecheck": "npm run typecheck:core",
    "typecheck:core": "tsc --noEmit -p tsconfig.typecheck-core.json",
    "typecheck:full": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "cleanup": "node scripts/cleanup.js",
    "clean": "node scripts/cleanup.js",
    "clean:cache": "powershell -Command \"if (Test-Path node_modules\\.vite) { Remove-Item -Recurse -Force node_modules\\.vite; Write-Host 'Cache limpo' } else { Write-Host 'Cache nao existe' }\""
  }
